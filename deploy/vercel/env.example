# Vercel 部署环境变量（值请填在 Vercel 项目 Settings -> Environment Variables，本文件不入库）
#
# 用法：vercel env add <NAME> production
#     或 Dashboard 批量粘贴。同名变量需在 Production / Preview 两个环境各配一次。

# ---- 必填：应用 ----
APP_NAME=DooTask
APP_ENV=production
APP_KEY=                     # php artisan key:generate --show 生成，形如 base64:...
APP_DEBUG=false
APP_URL=https://your-project.vercel.app
APP_TIMEZONE=Asia/Shanghai   # 可选，项目默认值在 config/app.php
APP_STORAGE_PATH=/tmp/dootask-storage

# ---- 必填：外部 MySQL（Vercel 不提供数据库）----
# 建议 PlanetScale / TiDB Cloud / Aiven / 阿里云 RDS，必须允许公网访问（或配置 Vercel Secure Compute）
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# PlanetScale / TiDB 等需要 TLS 时按厂商文档追加：
# MYSQL_ATTR_SSL_CA=                # 若厂商要求证书，改成在 config/database.php 指定路径
# DB_SOCKET=

# ---- 必填：外部 Redis（会话、缓存、队列）----
# 建议 Upstash Redis（提供 TLS 的 rediss:// 地址）
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# 若厂商只给 URL，DooTask 的 config/database.php 读的是 host/port 分项，需自行拆分

# ---- 契约适配层（本项目新增）----
PLATFORM_CONTRACT_ENABLED=true

# ---- 不配置即可用的默认项（列出便于排查）----
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# LOG_CHANNEL=stderr         # 只读文件系统下建议写 stderr，由 Vercel 日志收集

# ---- 已知不可用：不要浪费时间配置 ----
# 文件上传（写 public/uploads 只读）
# WebSocket 实时消息（需常驻 Swoole，端口 5200）
# OnlyOffice / drawio / fileview（需常驻 sidecar 容器）
# 定时任务（需常驻 crontab，Vercel Cron 仅支持 HTTP 触发且 Hobby 每天一次）

# Vercel 生产环境变量（本地文件，不入库；deploy.sh 会逐条写入 Vercel）
#
# 用法：
#   cp deploy/vercel/env.vercel.local.example deploy/vercel/env.vercel.local
#   填好后：VERCEL_TOKEN=xxx bash deploy/vercel/deploy.sh
#
# 规则：
#   1. 每行一个 KEY=VALUE，不要加引号，不要留空值（deploy.sh 会直接拒绝）；
#   2. # 开头为注释；
#   3. 变量只写入 Production；需要 Preview 环境时重复跑一次并在命令里改环境名。

# ---------- 应用 ----------
APP_NAME=DooTask
APP_ENV=production
APP_DEBUG=false
APP_KEY=                                   # php artisan key:generate --show
APP_URL=https://dootask.vercel.app          # 首次部署后可改成实际地址，影响回调与静态资源
APP_STORAGE_PATH=/tmp/dootask-storage
LOG_CHANNEL=stderr                          # 只读盘必须走 stderr，由 Vercel 收日志

# ---------- MySQL（TiDB Cloud Starter 免费版）----------
DB_CONNECTION=mysql
DB_HOST=                                   # gateway01.<region>.prod.aws.tidbcloud.com
DB_PORT=4000                               # TiDB 固定 4000，不是 3306
DB_DATABASE=dootask
DB_USERNAME=                               # 形如 3xxxxxx.root
DB_PASSWORD=
# TiDB 公网端点强制 TLS：值为 CA 证书路径，不是开关。
# Amazon Linux 2（vercel-php 运行时）自带公开根证书包，通常填这一行即可：
MYSQL_ATTR_SSL_CA=/etc/pki/tls/certs/ca-bundle.crt

# ---------- Redis（Upstash 免费版）----------
# 关键：vercel-php 运行时没有 phpredis 扩展，必须用 predis，否则连不上
REDIS_CLIENT=predis
# Upstash 强制 TLS，必须用 rediss:// 协议头；host/port/password 已包含在 URL 里
REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379
SESSION_DRIVER=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# ---------- 契约适配层 ----------
PLATFORM_CONTRACT_ENABLED=true

# ---------- 省事替代方案：完全不接 Redis ----------
# 不想开 Upstash 就把上面 Redis 段换成下面三行（代价：多实例间会话不共享，
# 队列任务同步执行）。三选一，不要同时留两套。
# SESSION_DRIVER=cookie
# CACHE_DRIVER=array
# QUEUE_CONNECTION=sync

# 阿里云 ECS 生产环境变量模板（复制为 .env 后填入真实值）
# 注意：APP_KEY 必须沿用本地已有值，否则已加密的数据无法解密

APP_NAME=警务实训平台
APP_ENV=production
APP_DEBUG=false
APP_KEY=            # 复用本地 .env 的 base64:... 值
APP_SCHEME=auto     # 前面没有 HTTPS 反代就保持 auto

# 对外访问地址（端口 8080，与 80 上的考试平台互不影响）
APP_URL=http://8.134.60.240:8080

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dootask
DB_USERNAME=dootask
DB_PASSWORD=        # 部署时生成
DB_PREFIX=pre_      # 必须与库里表名一致

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# predis 为纯 PHP 实现，不依赖 phpredis 扩展
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_SCHEME=tcp

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

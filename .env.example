APP_NAME=警务实训平台
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_SCHEME=auto
APP_URL=http://localhost

APP_PORT=2222

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---- 五平台契约适配层（规范 V2.0）----
# 契约中间件开关：true 时对 /api/** 叠加 code/requestId 并写访问日志；
# 设为 false 可完全回到 DooTask 原始行为（不叠加、不记录）。
PLATFORM_CONTRACT_ENABLED=true

# 仅用于本地脚本（lint/typecheck/test/preview）定位 PHP 解释器，运行时不读取。
# Windows 示例：PHP_BIN=D:/dt-run/php/php.exe
# PHP_BIN=

# ---- 五平台对接（网关 / 统一身份 / 考试平台 / 成果广场）----
# 规范依据：《实训平台_统一身份与网关接入说明》V3.0 §10.2.3、§13.1
# 密钥类变量一律由环境注入，此处只留空值。

# 平台编码：网关路径段、事件 sourcePlatform、X-App-Code 三处同值
APP_CODE=workshop
APP_VERSION=
APP_BUILD_TIME=

# —— 统一身份（OAuth 2.0 授权码 + PKCE）——
# mock 仅用于打通链路；测试与生产必须 real（§4.7）
SSO_MODE=mock
SSO_ISSUER=jingyuan-forum
SSO_BASE_URL=
SSO_CLIENT_ID=jy-workshop-web
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_POST_LOGOUT_URI=
SSO_SCOPE="openid profile"
SSO_PKCE=true
SSO_HTTP_TIMEOUT=3
SSO_INTROSPECT_TIMEOUT_MS=800
# mock 演示身份（仅 SSO_MODE=mock 生效）
SSO_MOCK_SUB=usr_mock_workshop_demo
SSO_MOCK_EMAIL=
SSO_MOCK_NICKNAME=演示用户
SSO_MOCK_ROLES=student

# —— 服务端会话 ——
# HTTPS 部署建议改为 __Host-workshop_sid（强制 Secure、Path=/、无 Domain）
WORKSHOP_SESSION_COOKIE=workshop_sid
WORKSHOP_SESSION_SECURE=false
WORKSHOP_SESSION_SAMESITE=Lax
SESSION_IDLE_TTL=1800
SESSION_ABS_TTL=28800

# —— 网关 ——
GATEWAY_PUBLIC_BASE=
# 已部署网关的公网地址，例如 http://8.138.246.181
GATEWAY_BASE_URL=
# L2 规范串版本：gateway = 已部署网关七段（appKey/ts/nonce/METHOD/path/query/sha256(body)）
#                  spec    = 接入说明 V3.0 四段（METHOD/path/query/body）
GATEWAY_L2_VERSION=gateway
# 生产必须 true；关闭会打印告警且不信任任何可信头
GATEWAY_VERIFY_SIGN=true
# 入站验签密钥（本平台专属）：内部签名密钥按平台独立，每平台一把 32 字节，
# 与 L2 AppSecret 不复用；勿填其他平台的 internal_sign_secret
GATEWAY_INTERNAL_SECRET=
# 也可从文件注入（容器 Secret / 600 挂载）；两者同时存在时以上面的直填值为准
GATEWAY_INTERNAL_SECRET_FILE=
GATEWAY_TRUSTED_CIDR=
GATEWAY_SKEW=300
# reject：签名缺失即 403（生产）；allow：允许直连调试（不信任 X-User-Id）
GATEWAY_DIRECT_ACCESS=reject
# 联调期允许存量 token 头访问 v1，切换完成后置 false
GATEWAY_ALLOW_TOKEN_FALLBACK=true
# CORS 白名单，逗号分隔；留空表示不启用跨域（同源部署不需要）
GATEWAY_CORS_ORIGINS=

# —— 考试平台（准入权威源）——
EXAM_BASE_URL=
EXAM_APP_KEY=jy-workshop-svc
EXAM_APP_SECRET=
EXAM_TIMEOUT_MS=1500
EXAM_CACHE_TTL=60
EXAM_PROJECTION_TTL=300
EXAM_CACHE_ENABLED=true
# 未配置 EXAM_BASE_URL 时自动 mock；也可显式开关
EXAM_MOCK=
EXAM_MOCK_ELIGIBLE=true
EXAM_MOCK_REASON=passed
# 经网关调用必须用 internal 前缀（L2 服务签名）；直连平台用其原生路径
EXAM_ADMISSION_PATH=/api/v1/exam/internal/admissions

# —— 成果广场（Work 权威源）——
SHOWCASE_BASE_URL=
SHOWCASE_APP_KEY=jy-workshop-svc
SHOWCASE_APP_SECRET=
SHOWCASE_TIMEOUT_MS=2000
SHOWCASE_MOCK=
# 网关侧成果广场的前缀是 plaza（不是 showcase），服务间调用走 internal
SHOWCASE_WORK_PATH=/api/v1/plaza/internal/works
SHOWCASE_WORK_QUERY_PATH=/api/v1/plaza/internal/works
SHOWCASE_AUTO_PUBLISH=false

# —— 论坛账号确认（密码代验式，只读）——
# 接口：POST {FORUM_VERIFY_BASE_URL}/answer/api/v1/account/verify
# 注意与 SSO 是两条独立路径：本段是过渡方案，SSO 授权码 + PKCE 是终态
FORUM_VERIFY_ENABLED=true
# 留空则复用 GATEWAY_BASE_URL（账号确认由网关回环到论坛，平台不直连论坛）
FORUM_VERIFY_BASE_URL=
FORUM_APP_KEY=jy-workshop-svc
# 留空即进入 mock：confirm 恒为 true 并回传 mock=true，只能本地演示，不能用于验收
FORUM_APP_SECRET=
FORUM_VERIFY_PATH=/answer/api/v1/account/verify
# 必须短于网关该路由的 3s 超时，留出写响应的余量
FORUM_VERIFY_TIMEOUT_MS=2500
FORUM_VERIFY_MOCK=
# 与 SSO_ISSUER 同一命名空间：两条路径拿到的都是论坛签发的身份
FORUM_ISSUER=jingyuan-forum
FORUM_CLIENT_ID=jy-workshop-web
# 失败节流：同一账号 + IP 连续失败达阈值即锁定，防止接口被当成撞库入口
FORUM_THROTTLE_MAX=5
FORUM_THROTTLE_WINDOW=300

# —— 幂等 ——
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL=86400
IDEMPOTENCY_LOCK_TTL=60
